generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_EMAIL_CONFIRMATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  BLOCKED
  DISABLED
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  firstName          String   @db.VarChar(100)
  lastName           String   @db.VarChar(100)
  nickname           String   @db.VarChar(50)
  nicknameNormalized String   @unique @db.VarChar(50)
  email              String   @db.VarChar(254)
  emailNormalized    String   @unique @db.VarChar(254)
  passwordHash       String
  role               UserRole @default(USER)
  status             UserStatus @default(PENDING_EMAIL_CONFIRMATION)
  emailVerifiedAt    DateTime? @db.Timestamptz(6)
  approvedAt         DateTime? @db.Timestamptz(6)
  approvedById       String?  @db.Uuid
  rejectedAt         DateTime? @db.Timestamptz(6)
  rejectedById       String?  @db.Uuid
  rejectionReason    String?  @db.VarChar(500)
  blockedAt          DateTime? @db.Timestamptz(6)
  blockedById        String?  @db.Uuid
  blockReason        String?  @db.VarChar(500)
  favoriteTeamId     String?  @db.Uuid
  isTestUser         Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime? @db.Timestamptz(6)

  approvedBy             User?                      @relation("UserApprovedBy", fields: [approvedById], references: [id])
  approvedUsers          User[]                      @relation("UserApprovedBy")
  blockedBy              User?                      @relation("UserBlockedBy", fields: [blockedById], references: [id])
  blockedUsers           User[]                      @relation("UserBlockedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  rejectedBy             User?                      @relation("UserRejectedBy", fields: [rejectedById], references: [id])
  rejectedUsers          User[]                      @relation("UserRejectedBy")
  roleChanges            RoleHistory[]              @relation("RoleHistoryUser")
  roleChangesPerformed   RoleHistory[]              @relation("RoleHistoryChangedBy")
  sessions               Session[]

  @@index([status])
  @@index([role])
  @@index([favoriteTeamId])
  @@index([createdAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RoleHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  previousRole   UserRole
  newRole        UserRole
  changedById    String   @db.Uuid
  reason         String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  changedBy User @relation("RoleHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  user      User @relation("RoleHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedById])
}
