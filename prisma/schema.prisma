generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_EMAIL_CONFIRMATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  BLOCKED
  DISABLED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum RoundStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  RESCHEDULED
  CLOSED
  SUSPENDED
  RESUMED
  FINISHED_PENDING
  PROCESSED
  CANCELLED
}

enum PredictionScoreType {
  EXACT
  PARTIAL
  WRONG
  NO_PREDICTION
}

enum AuditAction {
  LOGIN
  LOGOUT
  USER_REGISTERED
  USER_APPROVED
  USER_REJECTED
  USER_BLOCKED
  USER_UNBLOCKED
  USER_DISABLED
  USER_ROLE_CHANGED
  SEASON_CREATED
  SEASON_UPDATED
  SEASON_ACTIVATED
  SEASON_CLOSED
  ROUND_CREATED
  ROUND_UPDATED
  ROUND_ARCHIVED
  MATCH_CREATED
  MATCH_UPDATED
  MATCH_RESCHEDULED
  MATCH_SUSPENDED
  MATCH_RESUMED
  MATCH_CANCELLED
  MATCH_DOUBLE_CHANGED
  MATCH_PROCESSED
  MATCH_RESULT_CORRECTED
  PREDICTION_CREATED
  PREDICTION_UPDATED
  SEASON_RECALCULATED
  SETTINGS_UPDATED
  MAINTENANCE_ENABLED
  MAINTENANCE_DISABLED
  DATA_EXPORTED
  TEST_DATA_GENERATED
  SQL_QUERY_EXECUTED
  INTEGRITY_CHECK_EXECUTED
}

enum AuditEntityType {
  USER
  TEAM
  SEASON
  ROUND
  MATCH
  PREDICTION
  STANDING
  SPONSOR
  SETTING
  SYSTEM
}

enum NotificationType {
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  MATCH_CLOSING_SOON
  PREDICTIONS_PENDING
  MATCH_RESCHEDULED
  MATCH_PROCESSED
  SEASON_STARTED
  SYSTEM
}

enum OperationalLockType {
  MATCH_PROCESSING
  SEASON_RECALCULATION
  IMPORT
  CRITICAL_OPERATION
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ApplicationSettingKey {
  APPLICATION_NAME
  APPLICATION_LOGO_PATH
  APPLICATION_MAINTENANCE_MODE
  APPLICATION_HOW_IT_WORKS
  APPLICATION_SOCIAL_LINKS
  DIAGNOSTICS_ENABLED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  firstName          String     @db.VarChar(100)
  lastName           String     @db.VarChar(100)
  nickname           String     @db.VarChar(50)
  nicknameNormalized String     @unique @db.VarChar(50)
  email              String     @db.VarChar(254)
  emailNormalized    String     @unique @db.VarChar(254)
  passwordHash       String
  role               UserRole   @default(USER)
  status             UserStatus @default(PENDING_EMAIL_CONFIRMATION)
  emailVerifiedAt    DateTime?  @db.Timestamptz(6)
  approvedAt         DateTime?  @db.Timestamptz(6)
  approvedById       String?    @db.Uuid
  rejectedAt         DateTime?  @db.Timestamptz(6)
  rejectedById       String?    @db.Uuid
  rejectionReason    String?    @db.VarChar(500)
  blockedAt          DateTime?  @db.Timestamptz(6)
  blockedById        String?    @db.Uuid
  blockReason        String?    @db.VarChar(500)
  favoriteTeamId     String?    @db.Uuid
  isTestUser         Boolean    @default(false)
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?  @db.Timestamptz(6)

  approvedBy                  User?                    @relation("UserApprovedBy", fields: [approvedById], references: [id])
  approvedUsers               User[]                   @relation("UserApprovedBy")
  auditLogs                   AuditLog[]
  blockedBy                   User?                    @relation("UserBlockedBy", fields: [blockedById], references: [id])
  blockedUsers                User[]                   @relation("UserBlockedBy")
  closedSeasons               Season[]                 @relation("SeasonClosedBy")
  emailVerificationTokens     EmailVerificationToken[]
  exportRuns                  ExportRun[]              @relation("ExportRunRequestedBy")
  favoriteTeam                Team?                    @relation("FavoriteTeam", fields: [favoriteTeamId], references: [id], onDelete: SetNull)
  matchScheduleChanges        MatchScheduleHistory[]   @relation("MatchScheduleChangedBy")
  matchesProcessed            Match[]                  @relation("MatchProcessedBy")
  matchesProcessing           Match[]                  @relation("MatchProcessingStartedBy")
  matchResultsRecorded        MatchResult[]            @relation("MatchResultRecordedBy")
  notifications               Notification[]
  operationalLocks            OperationalLock[]        @relation("OperationalLockAcquiredBy")
  passwordResetTokens         PasswordResetToken[]
  predictions                 Prediction[]
  predictionScores            PredictionScore[]
  predictionScoresCalculated  PredictionScore[]        @relation("PredictionScoreCalculatedBy")
  rejectedBy                  User?                    @relation("UserRejectedBy", fields: [rejectedById], references: [id])
  rejectedUsers               User[]                   @relation("UserRejectedBy")
  roleChanges                 RoleHistory[]            @relation("RoleHistoryUser")
  roleChangesPerformed        RoleHistory[]            @relation("RoleHistoryChangedBy")
  seasonParticipantExclusions SeasonParticipant[]      @relation("SeasonParticipantExcludedBy")
  seasonParticipations        SeasonParticipant[]
  sessions                    Session[]
  standings                   Standing[]
  standingSnapshots           StandingSnapshot[]
  diagnosticRuns              DiagnosticRun[]          @relation("DiagnosticRunExecutedBy")
  updatedSettings             ApplicationSetting[]     @relation("ApplicationSettingUpdatedBy")

  @@index([status])
  @@index([role])
  @@index([favoriteTeamId])
  @@index([createdAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(255)
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RoleHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  previousRole UserRole
  newRole      UserRole
  changedById  String   @db.Uuid
  reason       String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  changedBy User @relation("RoleHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  user      User @relation("RoleHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedById])
}

model Team {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar(120)
  shortName    String    @db.VarChar(30)
  slug         String    @unique @db.VarChar(120)
  logoPath     String?   @db.VarChar(500)
  displayOrder Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  awayMatches     Match[] @relation("AwayTeam")
  favoriteOfUsers User[]  @relation("FavoriteTeam")
  homeMatches     Match[] @relation("HomeTeam")

  @@index([isActive])
  @@index([displayOrder])
}

model Season {
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String       @unique @db.VarChar(100)
  slug                   String       @unique @db.VarChar(120)
  status                 SeasonStatus @default(DRAFT)
  startsAt               DateTime?    @db.Timestamptz(6)
  endsAt                 DateTime?    @db.Timestamptz(6)
  closedAt               DateTime?    @db.Timestamptz(6)
  closedById             String?      @db.Uuid
  exactPoints            Int          @default(3)
  partialPoints          Int          @default(1)
  wrongPoints            Int          @default(0)
  doubleMultiplier       Int          @default(2)
  predictionCloseMinutes Int          @default(5)
  maxPredictionGoals     Int          @default(20)
  createdAt              DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(6)
  archivedAt             DateTime?    @db.Timestamptz(6)

  closedBy          User?               @relation("SeasonClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  matches           Match[]
  participants      SeasonParticipant[]
  predictionScores  PredictionScore[]
  rounds            Round[]
  standingSnapshots StandingSnapshot[]
  standings         Standing[]

  @@index([status])
}

model SeasonParticipant {
  id              String    @id @default(uuid()) @db.Uuid
  seasonId        String    @db.Uuid
  userId          String    @db.Uuid
  joinedAt        DateTime  @default(now()) @db.Timestamptz(6)
  isEligible      Boolean   @default(true)
  excludedAt      DateTime? @db.Timestamptz(6)
  excludedById    String?   @db.Uuid
  exclusionReason String?   @db.VarChar(500)
  isTestData      Boolean   @default(false)

  excludedBy User?  @relation("SeasonParticipantExcludedBy", fields: [excludedById], references: [id], onDelete: Restrict)
  season     Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  user       User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([seasonId, userId])
  @@index([userId])
}

model Round {
  id          String      @id @default(uuid()) @db.Uuid
  seasonId    String      @db.Uuid
  name        String      @db.VarChar(120)
  slug        String      @db.VarChar(150)
  sequence    Int?
  status      RoundStatus @default(DRAFT)
  description String?     @db.VarChar(500)
  publishedAt DateTime?   @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  archivedAt  DateTime?   @db.Timestamptz(6)

  matches Match[]
  season  Season  @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@unique([seasonId, slug])
  @@index([seasonId])
  @@index([status])
  @@index([sequence])
}

model Match {
  id                    String      @id @default(uuid()) @db.Uuid
  seasonId              String      @db.Uuid
  roundId               String      @db.Uuid
  homeTeamId            String      @db.Uuid
  awayTeamId            String      @db.Uuid
  scheduledAt           DateTime    @db.Timestamptz(6)
  originalScheduledAt   DateTime?   @db.Timestamptz(6)
  predictionClosesAt    DateTime    @db.Timestamptz(6)
  status                MatchStatus @default(SCHEDULED)
  isDoublePoints        Boolean     @default(false)
  venue                 String?     @db.VarChar(200)
  notes                 String?
  officialHomeGoals     Int?
  officialAwayGoals     Int?
  processedAt           DateTime?   @db.Timestamptz(6)
  processedById         String?     @db.Uuid
  resultVersion         Int         @default(1)
  processingStartedAt   DateTime?   @db.Timestamptz(6)
  processingStartedById String?     @db.Uuid
  createdAt             DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(6)
  archivedAt            DateTime?   @db.Timestamptz(6)

  awayTeam            Team                   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  homeTeam            Team                   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  processedBy         User?                  @relation("MatchProcessedBy", fields: [processedById], references: [id], onDelete: Restrict)
  processingStartedBy User?                  @relation("MatchProcessingStartedBy", fields: [processingStartedById], references: [id], onDelete: Restrict)
  round               Round                  @relation(fields: [roundId], references: [id], onDelete: Restrict)
  results             MatchResult[]
  predictions         Prediction[]
  predictionScores    PredictionScore[]
  scheduleHistory     MatchScheduleHistory[]
  season              Season                 @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  standingSnapshots   StandingSnapshot[]     @relation("StandingSnapshotTriggerMatch")

  @@index([seasonId])
  @@index([roundId])
  @@index([scheduledAt])
  @@index([predictionClosesAt])
  @@index([status])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([processedAt])
}

model MatchScheduleHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  matchId             String   @db.Uuid
  previousScheduledAt DateTime @db.Timestamptz(6)
  newScheduledAt      DateTime @db.Timestamptz(6)
  previousClosesAt    DateTime @db.Timestamptz(6)
  newClosesAt         DateTime @db.Timestamptz(6)
  reason              String?  @db.VarChar(500)
  changedById         String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  changedBy User  @relation("MatchScheduleChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  match     Match @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([changedById])
}

model Prediction {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  matchId     String    @db.Uuid
  homeGoals   Int
  awayGoals   Int
  submittedAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  lockedAt    DateTime? @db.Timestamptz(6)
  source      String?   @db.VarChar(30)
  isTestData  Boolean   @default(false)
  deletedAt   DateTime? @db.Timestamptz(6)

  match  Match             @relation(fields: [matchId], references: [id], onDelete: Restrict)
  scores PredictionScore[]
  user   User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([submittedAt])
}

model MatchResult {
  id               String   @id @default(uuid()) @db.Uuid
  matchId          String   @db.Uuid
  homeGoals        Int
  awayGoals        Int
  version          Int
  isCurrent        Boolean  @default(true)
  recordedById     String   @db.Uuid
  correctionReason String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  match      Match             @relation(fields: [matchId], references: [id], onDelete: Restrict)
  scores     PredictionScore[]
  recordedBy User              @relation("MatchResultRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([matchId, version])
  @@index([matchId])
  @@index([recordedById])
}

model PredictionScore {
  id             String              @id @default(uuid()) @db.Uuid
  seasonId       String              @db.Uuid
  userId         String              @db.Uuid
  matchId        String              @db.Uuid
  predictionId   String?             @db.Uuid
  matchResultId  String              @db.Uuid
  scoreType      PredictionScoreType
  basePoints     Int
  multiplier     Int
  awardedPoints  Int
  resultVersion  Int
  calculatedAt   DateTime            @default(now()) @db.Timestamptz(6)
  calculatedById String?             @db.Uuid

  calculatedBy User?       @relation("PredictionScoreCalculatedBy", fields: [calculatedById], references: [id], onDelete: Restrict)
  match        Match       @relation(fields: [matchId], references: [id], onDelete: Restrict)
  matchResult  MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Restrict)
  prediction   Prediction? @relation(fields: [predictionId], references: [id], onDelete: Restrict)
  season       Season      @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId, resultVersion])
  @@index([seasonId])
  @@index([matchId])
  @@index([scoreType])
  @@index([predictionId])
  @@index([matchResultId])
}

model Standing {
  id                String   @id @default(uuid()) @db.Uuid
  seasonId          String   @db.Uuid
  userId            String   @db.Uuid
  position          Int
  previousPosition  Int?
  totalPoints       Int      @default(0)
  exactCount        Int      @default(0)
  partialCount      Int      @default(0)
  wrongCount        Int      @default(0)
  noPredictionCount Int      @default(0)
  matchesScored     Int      @default(0)
  recalculatedAt    DateTime @default(now()) @db.Timestamptz(6)
  version           Int      @default(1)

  season Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([seasonId, userId])
  @@index([seasonId, position])
  @@index([seasonId, totalPoints, exactCount])
}

model StandingSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  seasonId        String   @db.Uuid
  userId          String   @db.Uuid
  triggerMatchId  String?  @db.Uuid
  position        Int
  totalPoints     Int      @default(0)
  exactCount      Int      @default(0)
  partialCount    Int      @default(0)
  snapshotVersion Int
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  season       Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  triggerMatch Match? @relation("StandingSnapshotTriggerMatch", fields: [triggerMatchId], references: [id], onDelete: Restrict)
  user         User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([seasonId, userId, snapshotVersion])
  @@index([seasonId, createdAt])
  @@index([userId, createdAt])
  @@index([triggerMatchId])
}

model AuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  actorUserId  String?         @db.Uuid
  actorRole    UserRole?
  action       AuditAction
  entityType   AuditEntityType
  entityId     String?         @db.Uuid
  beforeJson   Json?           @db.JsonB
  afterJson    Json?           @db.JsonB
  metadataJson Json?           @db.JsonB
  ipAddress    String?         @db.VarChar(64)
  userAgent    String?         @db.VarChar(500)
  requestId    String?         @db.VarChar(100)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([requestId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(150)
  message   String           @db.VarChar(1000)
  link      String?          @db.VarChar(500)
  dataJson  Json?            @db.JsonB
  readAt    DateTime?        @db.Timestamptz(6)
  expiresAt DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Sponsor {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  imagePath    String?   @db.VarChar(500)
  targetUrl    String?   @db.VarChar(500)
  isActive     Boolean   @default(true)
  displayOrder Int
  startsAt     DateTime? @db.Timestamptz(6)
  endsAt       DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)

  @@index([isActive])
  @@index([displayOrder])
}

model ApplicationSetting {
  id          String                @id @default(uuid()) @db.Uuid
  key         ApplicationSettingKey @unique
  valueJson   Json                  @db.JsonB
  description String?               @db.VarChar(500)
  isPublic    Boolean               @default(false)
  updatedById String?               @db.Uuid
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)

  updatedBy User? @relation("ApplicationSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isPublic])
}

model OperationalLock {
  id           String              @id @default(uuid()) @db.Uuid
  lockType     OperationalLockType
  resourceKey  String              @db.VarChar(200)
  acquiredById String?             @db.Uuid
  requestId    String?             @db.VarChar(100)
  acquiredAt   DateTime            @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime            @db.Timestamptz(6)
  releasedAt   DateTime?           @db.Timestamptz(6)

  acquiredBy User? @relation("OperationalLockAcquiredBy", fields: [acquiredById], references: [id], onDelete: SetNull)

  @@unique([lockType, resourceKey])
  @@index([expiresAt])
  @@index([requestId])
}

model DiagnosticRun {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @db.VarChar(100)
  executedById   String?   @db.Uuid
  status         RunStatus @default(PENDING)
  summaryJson    Json?     @db.JsonB
  sanitizedError String?   @db.VarChar(1000)
  requestId      String?   @db.VarChar(100)
  startedAt      DateTime  @default(now()) @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)

  executedBy User? @relation("DiagnosticRunExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([startedAt])
  @@index([requestId])
}

model ExportRun {
  id             String    @id @default(uuid()) @db.Uuid
  requestedById  String?   @db.Uuid
  exportType     String    @db.VarChar(100)
  format         String    @db.VarChar(20)
  status         RunStatus @default(PENDING)
  rowCount       Int?
  storageKey     String?   @db.VarChar(500)
  expiresAt      DateTime? @db.Timestamptz(6)
  summaryJson    Json?     @db.JsonB
  sanitizedError String?   @db.VarChar(1000)
  requestId      String?   @db.VarChar(100)
  startedAt      DateTime  @default(now()) @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)

  requestedBy User? @relation("ExportRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([status])
  @@index([expiresAt])
  @@index([requestId])
}
