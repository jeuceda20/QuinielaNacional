NODE_ENV=production
APP_URL=https://your-production-host.example
APP_TIMEZONE=America/Tegucigalpa

# Supabase shared pooler in transaction mode (port 6543) for serverless app traffic.
# Copy the exact URL from Supabase Dashboard > Connect; do not commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase direct connection (port 5432) for Prisma migrations and backups.
# It requires IPv6 on the free plan. If the migration runner has only IPv4, use the
# shared pooler session URL from the Connect panel instead.
DIRECT_DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Generate distinct, high-entropy production-only values. Never reuse preview values.
SESSION_SECRET=replace-with-a-production-only-secret
INITIAL_SETUP_TOKEN=replace-with-a-single-use-production-only-token

# Keep email delivery disabled until TASK-121 configures the project SMTP account.
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_USER=production-placeholder
SMTP_APP_PASSWORD=production-placeholder

ENABLE_DIAGNOSTICS=false
ENABLE_SQL_CONSOLE=false
ENABLE_SQL_WRITE=false
ENABLE_TEST_DATA_TOOLS=false
