NODE_ENV=production
APP_URL=https://preview.example.invalid
APP_TIMEZONE=America/Tegucigalpa

# Use a dedicated preview database. Never reuse production credentials.
DATABASE_URL=postgresql://preview_user:preview_password@preview-db.example.invalid:5432/quiniela_preview
DIRECT_DATABASE_URL=postgresql://preview_user:preview_password@preview-db.example.invalid:5432/quiniela_preview

# Generate distinct preview-only values; do not copy production secrets.
SESSION_SECRET=replace-with-a-preview-only-secret
INITIAL_SETUP_TOKEN=replace-with-a-preview-only-token

# Preview must not send real email.
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_USER=preview
SMTP_APP_PASSWORD=preview-only-placeholder

ENABLE_DIAGNOSTICS=false
ENABLE_SQL_CONSOLE=false
ENABLE_SQL_WRITE=false
ENABLE_TEST_DATA_TOOLS=false
